<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Video Formats</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="container py-5">
      <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
          <form method="POST" action="/">
            <div class="mb-4 text-center">
              <label for="videoUrl" class="form-label fw-bold display-6"
                >Enter Video URL</label
              >
              <input
                type="text"
                name="videoUrl"
                class="form-control mt-3"
                id="videoUrl"
                placeholder="Paste video URL here"
                required
              />
            </div>
            <div class="d-grid">
              <button type="submit" class="btn btn-success btn-lg">
                Submit
              </button>
            </div>
          </form>

          <% if (formats && formats.length > 0) { %>
          <div class="mt-5">
            <h3 class="mb-3 text-center">Available Download Links</h3>
            <ul class="list-group">
              <% formats.forEach(format => { %>
              <li
                class="list-group-item d-flex justify-content-between align-items-center flex-wrap"
              >
                <span><strong><%= format.format_id %></strong></span>
                <a
                  href="<%= format.download_url %>"
                  target="_blank"
                  class="btn btn-outline-primary btn-sm mt-2 mt-md-0"
                  >Download</a
                >
              </li>
              <% }) %>
            </ul>
          </div>
          <% } else if (formats) { %>
          <p class="text-danger mt-4 text-center">
            No formats found or invalid URL.
          </p>
          <% } %>
        </div>
      </div>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.min.js"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
