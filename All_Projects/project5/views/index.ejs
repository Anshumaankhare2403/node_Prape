    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>URl Shorter</title>
        <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT"
        crossorigin="anonymous"
        />
    </head>
    <body class="bg-dark">
        <p class="fs-1 fw-bold text-center text-light mt-5 pt-5">
        <a
            href="http://localhost:2003/url"
            class="link-offset-2 link-underline link-underline-opacity-0 link-light"
            >URL Shorter</a
        >
        </p>

        <div class="d-flex justify-content-center">
        <div class="card" style="width: 40rem">
            <div class="card-body">
            <h5 class="card-title">Enter You URL ...</h5>
            <form method="post" action="/url">
                <div class="mb-3 pt-3">
                <input
                    type="text"
                    class="form-control"
                    id="url"
                    name="url"
                    placeholder="http://www.com"
                    required
                />
                </div>
                <button type="submit" class="btn btn-primary w-100">Submit</button>
            </form>

            <% if (message) { %>
            <div class="alert alert-success mt-4">
                <%= message %>:
                <a
                class="text-decoration-underline"
                href="http://localhost:2003/url/<%= shortID %>"
                >
                http://localhost:2003/url/<%= shortID %>
                </a>
            </div>
            <% } %>
            </div>
        </div>
        </div>

        <script
        src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"
        ></script>
        <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.min.js"
        integrity="sha384-RuyvpeZCxMJCqVUGFI0Do1mQrods/hhxYlcVfGPOfQtPJh0JCw12tUAZ/Mv10S7D"
        crossorigin="anonymous"
        ></script>
    </body>
    </html>
